APP_NAME="GymXBook API"
APP_ENV=production
APP_KEY=base64:YOU_NEED_TO_RUN_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://web.gymxbook.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ═══════════════════════════════════════════════════════════════
# DATABASE - Update with your actual credentials
# ═══════════════════════════════════════════════════════════════
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gymxbook
DB_USERNAME=gymxbook_user
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

# ═══════════════════════════════════════════════════════════════
# CACHE & SESSION
# ═══════════════════════════════════════════════════════════════
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ═══════════════════════════════════════════════════════════════
# SANCTUM (API Authentication)
# ═══════════════════════════════════════════════════════════════
SANCTUM_STATEFUL_DOMAINS=web.gymxbook.com,gymxbook.com,admin.gymxbook.com,panel.gymxbook.com

# ═══════════════════════════════════════════════════════════════
# CASHFREE PAYMENT GATEWAY
# ═══════════════════════════════════════════════════════════════
# TEST MODE (current)
CASHFREE_APP_ID=TEST11110086697be295b81eb8db7ef068001111
CASHFREE_SECRET_KEY=cfsk_ma_test_3185487ef4ace00eb1d1f0d1f43baeba_9c490924
CASHFREE_SANDBOX=true
CASHFREE_API_VERSION=2023-08-01

# PRODUCTION MODE (uncomment when ready)
# CASHFREE_APP_ID=YOUR_PRODUCTION_APP_ID
# CASHFREE_SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY
# CASHFREE_SANDBOX=false

# ═══════════════════════════════════════════════════════════════
# WHATSAPP API (Optional)
# ═══════════════════════════════════════════════════════════════
# Copied from old gymxbook/lib/whatsapp_config.php
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_
WHATSAPP_PHONE_NUMBER_ID=1151121884757409
WHATSAPP_API_VERSION=v20.0

# New OTP template (preferred)
WHATSAPP_OTP_TEMPLATE_NAME=gymxbook_otp

# Timezone - set to Asia/Kolkata (IST) for entire project
APP_TIMEZONE=Asia/Kolkata

# ═══════════════════════════════════════════════════════════════
# MAIL (Optional - for notifications)
# ═══════════════════════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@gymxbook.com
MAIL_FROM_NAME="GymXBook"
